CC = gcc
OPT = -O2
DEF = -D$(ARCH)
DEBUG = -g
WARN = -Wall -Wextra -Wformat=2 -Wno-unused-parameter
PIC = -fPIC
# undefine first: some distributions already set _FORTIFY_SOURCE
FORTIFY = -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=2
HARDEN = -fstack-protector-strong
HARDEN_LDFLAGS = -Wl,-z,relro,-z,now
GPLC = gplc
SWIPL = swipl
LINK = $(CC)
AR = ar
RANLIB = ranlib
